"<mujoco>"
"</mujoco>"
"<mujoco model=\"m\">"
"<compiler angle=\"radian\" autolimits=\"true\" inertiafromgeom=\"true\"/>"
"<compiler boundmass=\"1\" boundinertia=\"1\" settotalmass=\"1\" balanceinertia=\"true\"/>"
"<option timestep=\"0.002\" gravity=\"0 0 -9.81\" integrator=\"implicit\"/>"
"<option solver=\"Newton\" cone=\"elliptic\" jacobian=\"sparse\" noslip_iterations=\"3\"/>"
"<flag contact=\"disable\" constraint=\"disable\" warmstart=\"disable\" energy=\"enable\"/>"
"<size memory=\"1M\" nconmax=\"10\" njmax=\"10\"/>"
"<default>"
"<default class=\"c\">"
"</default>"
"<asset>"
"</asset>"
"<texture name=\"t\" type=\"2d\" builtin=\"checker\" width=\"8\" height=\"8\" rgb1=\"1 0 0\" rgb2=\"0 1 0\"/>"
"<texture type=\"skybox\" builtin=\"gradient\"/>"
"<material name=\"mat\" texture=\"t\" reflectance=\".1\"/>"
"<hfield name=\"h\" nrow=\"4\" ncol=\"4\" size=\"1 1 1 .1\"/>"
"<mesh name=\"mm\" vertex=\"0 0 0 1 0 0 0 1 0 0 0 1\"/>"
"<mesh name=\"mm\" builtin=\"sphere\" params=\"3\"/>"
"<worldbody>"
"</worldbody>"
"<body name=\"b\" pos=\"0 0 1\">"
"</body>"
"<freejoint/>"
"<joint type=\"hinge\" axis=\"0 0 1\" range=\"-1 1\" damping=\"1\" stiffness=\"1\"/>"
"<joint type=\"ball\"/>"
"<joint type=\"slide\"/>"
"<geom type=\"sphere\" size=\"0.1\"/>"
"<geom type=\"capsule\" fromto=\"0 0 0 0 0 1\" size=\".1\"/>"
"<geom type=\"mesh\" mesh=\"mm\"/>"
"<geom type=\"hfield\" hfield=\"h\"/>"
"<geom type=\"sdf\" mesh=\"mm\"/>"
"<geom type=\"plane\" size=\"1 1 .1\"/>"
"<geom type=\"ellipsoid\" size=\"1 2 3\"/>"
"<geom type=\"cylinder\" size=\"1 1\"/>"
"<geom type=\"box\" size=\"1 1 1\"/>"
"<site name=\"s\" pos=\"0 0 0\"/>"
"<camera name=\"cam\" mode=\"track\"/>"
"<light directional=\"true\"/>"
"<inertial pos=\"0 0 0\" mass=\"1\" diaginertia=\"1 1 1\"/>"
"<composite type=\"particle\" count=\"3 3 3\" spacing=\"0.1\"/>"
"<composite type=\"cable\" count=\"5 1 1\"/>"
"<flexcomp type=\"grid\" count=\"3 3 1\" spacing=\".1 .1 .1\" radius=\".01\" dim=\"2\"/>"
"<flexcomp type=\"box\" count=\"3 3 3\" spacing=\".1 .1 .1\" dim=\"3\"/>"
"<replicate count=\"2\" offset=\"1 0 0\">"
"</replicate>"
"<frame pos=\"0 0 1\" euler=\"0 0 90\">"
"</frame>"
"<attach model=\"m\" body=\"b\" prefix=\"p_\"/>"
"<contact>"
"<pair geom1=\"a\" geom2=\"b\"/>"
"<exclude body1=\"a\" body2=\"b\"/>"
"</contact>"
"<equality>"
"<weld body1=\"a\" body2=\"b\"/>"
"<connect body1=\"a\" body2=\"b\" anchor=\"0 0 0\"/>"
"<joint joint1=\"a\" joint2=\"b\" polycoef=\"0 1 0 0 0\"/>"
"<flex flex=\"f\"/>"
"</equality>"
"<tendon>"
"<spatial name=\"t\"><site site=\"s\"/><geom geom=\"g\"/></spatial>"
"<fixed name=\"t\"><joint joint=\"j\" coef=\"1\"/></fixed>"
"</tendon>"
"<actuator>"
"<motor joint=\"j\" gear=\"1\" ctrlrange=\"-1 1\"/>"
"<position joint=\"j\" kp=\"1\"/>"
"<velocity joint=\"j\" kv=\"1\"/>"
"<general joint=\"j\" dyntype=\"filter\" gaintype=\"affine\" biastype=\"affine\"/>"
"<muscle joint=\"j\" lengthrange=\"0 1\"/>"
"<cylinder joint=\"j\"/>"
"<damper joint=\"j\" kv=\"1\"/>"
"</actuator>"
"<sensor>"
"<jointpos joint=\"j\"/>"
"<accelerometer site=\"s\"/>"
"<framepos objtype=\"body\" objname=\"b\"/>"
"<rangefinder site=\"s\"/>"
"<touch site=\"s\"/>"
"<user dim=\"1\"/>"
"</sensor>"
"<keyframe>"
"<key qpos=\"0\" time=\"1\"/>"
"</keyframe>"
"<custom>"
"<numeric name=\"n\" data=\"1\"/>"
"<text name=\"t\" data=\"d\"/>"
"</custom>"
"<extension>"
"<plugin plugin=\"mujoco.pid\"/>"
"</extension>"
"<robot name=\"r\">"
"</robot>"
"<link name=\"l\">"
"<joint name=\"j\" type=\"revolute\">"
"<origin xyz=\"0 0 0\" rpy=\"0 0 0\"/>"
"<mass value=\"1\"/>"
"<inertia ixx=\"1\" iyy=\"1\" izz=\"1\" ixy=\"0\" ixz=\"0\" iyz=\"0\"/>"
"<limit lower=\"-1\" upper=\"1\"/>"
